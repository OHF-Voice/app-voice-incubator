#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start voice_labs. It reads its options from /data/options.json and talks to
# Home Assistant through the Supervisor with SUPERVISOR_TOKEN.
# ==============================================================================
cd /usr/src/voice_labs || bashio::exit.nok "The app's code is missing from /usr/src/voice_labs"
exec python3 -m voice_labs --data-dir /data --http-port 8099
